version = "1.0.0"
name = "awesome"
alias = "ap"
description = "A collection of role-focused Claude Code playbooks: DBA, SRE, SEO, SecOps, Frontend, Backend, Data, and Technical Writer."

[[children]]
name = "dba"
path = "playbooks/dba"
alias = "ap-dba"
description = "Database administrator: schema design, query tuning, migrations, backups."

[[children]]
name = "sre"
path = "playbooks/sre"
alias = "ap-sre"
description = "Site reliability engineer: incident response, observability, on-call, postmortems."

[[children]]
name = "seo"
path = "playbooks/seo"
alias = "ap-seo"
description = "SEO specialist: on-page audits, structured data, Core Web Vitals, content strategy."

[[children]]
name = "secops"
path = "playbooks/secops"
alias = "ap-sec"
description = "Security operations: threat modeling, code review, vulnerability triage, hardening."

[[children]]
name = "frontend"
path = "playbooks/frontend"
alias = "ap-fe"
description = "Frontend engineer: React/Vue/Svelte, accessibility, performance, design systems."

[[children]]
name = "backend"
path = "playbooks/backend"
alias = "ap-be"
description = "Backend engineer: API design, services, auth, caching, message queues."

[[children]]
name = "data"
path = "playbooks/data"
alias = "ap-data"
description = "Data engineer / analyst: pipelines, warehousing, dbt, SQL analytics."

[[children]]
name = "writer"
path = "playbooks/writer"
alias = "ap-write"
description = "Technical writer: docs, READMEs, API references, release notes."
